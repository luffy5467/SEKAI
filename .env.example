# =============================================================================
# playercn — environment
# =============================================================================
# Copy to `.env` and fill in. Everything marked REQUIRED is validated at boot:
# the server refuses to start with a precise message rather than failing on the
# first request that happens to need the value.
#
# Generate the JWT keypair first:   ./scripts/gen-keys.sh
# =============================================================================

# --- Core --------------------------------------------------------------------

# development | production. Production additionally enforces secure cookies
# and an https web origin.
APP_ENV=development

BIND_ADDR=0.0.0.0:8080

# Where the API is reachable from the internet. Used to build the Google OAuth
# redirect URI when GOOGLE_REDIRECT_URI is not set explicitly.
PUBLIC_URL=http://localhost:8080

# The browser origin. Sets CORS and is the only destination the OAuth flow will
# redirect back to.
WEB_ORIGIN=http://localhost:3000

# --- Proxy authentication & client IP (API) ------------------------------------
# Browsers reach /api through the SEKAI web proxy (Vercel, or the web container
# when self-hosting), which attaches SEKAI_PROXY_SECRET and the visitor's IP.
# The API trusts that IP only with the right secret; it never trusts
# X-Forwarded-For / X-Real-IP / CF-Connecting-IP on their own.
# (TRUST_PROXY_HEADERS is no longer used; the server warns if it is set.)
#
# Shared secret, identical on the API and the web proxy. At least 32
# characters: `openssl rand -hex 32`. Never commit a real value.
SEKAI_PROXY_SECRET=
#
# Refuse /api without the secret (403). Defaults to true when APP_ENV=production,
# and the server then refuses to START without SEKAI_PROXY_SECRET.
# An explicit `false` lets production start without a secret and serves /api to
# direct callers; every per-IP limit then keys on the TCP peer (your edge
# proxy, i.e. one bucket for everyone) unless EDGE_CLIENT_IP_HEADER is set.
# Only for an API reachable solely through a trusted same-origin proxy.
# Development leaves it false, so local work needs no secret.
# REQUIRE_PROXY_AUTH=
#
# A header the edge in front of the API is VERIFIED to overwrite on every
# request (e.g. Caddy's `header_up X-Real-IP {remote_host}`). Used for direct
# callers such as WebSocket upgrades. Leave empty until verified: an
# overwritable header here lets anyone pick their own rate-limit identity.
EDGE_CLIENT_IP_HEADER=

# --- Datastores (REQUIRED) ----------------------------------------------------

DATABASE_URL=postgres://ytroom:ytroom@localhost:5432/ytroom
DATABASE_MAX_CONNECTIONS=20
DATABASE_MIN_CONNECTIONS=2
DATABASE_ACQUIRE_TIMEOUT_SECS=10

REDIS_URL=redis://localhost:6379

# --- Tokens (REQUIRED) --------------------------------------------------------
# Ed25519 PKCS#8 PEM. Either paste inline (with literal \n escapes) or point at
# a file — Docker secrets and Dokploy's UI disagree about which is idiomatic,
# so both work.
#
#   JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMC4...\n-----END PRIVATE KEY-----\n"
#
JWT_PRIVATE_KEY_FILE=./keys/jwt-private.pem
JWT_PUBLIC_KEY_FILE=./keys/jwt-public.pem

ACCESS_TOKEN_TTL_SECS=900          # 15 minutes, held in browser memory only
REFRESH_TOKEN_TTL_SECS=2592000     # 30 days, httpOnly cookie, rotated on use
WS_TICKET_TTL_SECS=30              # single-use socket credential

# Leave empty in almost all cases, including split api./app. subdomains: only
# the API ever reads this cookie, so a host-only cookie is correct and narrower.
# Sibling subdomains still count as same-site, so SameSite=Lax is satisfied.
# Set it only if a second service on another subdomain must read the cookie.
COOKIE_DOMAIN=
# Defaults to true in production and false in development, which is almost
# always what you want. The server refuses to start if it is false in
# production. Only set it explicitly to override that.
# COOKIE_SECURE=

# --- Google Sign-In -----------------------------------------------------------
# Nominally optional, but note: guests can join rooms and cannot create them, so
# with these unset *nobody* can create a room and the deployment is a dead end.
# Set them unless you are seeding rooms another way.
#
# In Google Cloud Console create an OAuth 2.0 Web client and add
# `${PUBLIC_URL}/api/auth/google/callback` as an authorised redirect URI.
# Scopes requested: openid, email, profile. Nothing else.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- YouTube Data API (optional) ----------------------------------------------
# Without a key, in-app search is disabled but pasting links still works.
# Server-side only; never exposed to the browser.
YOUTUBE_API_KEY=
YOUTUBE_CACHE_TTL_SECS=43200

# --- Kick (optional) ----------------------------------------------------------
# Client credentials from kick.com/settings/developer. Only the "Read channel
# information" scope is needed — never "Read stream key", which is the
# credential for broadcasting *as* a channel.
#
# This buys metadata, not playback: Kick's API returns an empty `stream.url` for
# channels you do not own, so a Kick channel is still played through its embed.
# What it gives is the title, the artwork and whether the channel is live — and
# the artwork matters most for viewers who cannot reach Kick at all, since it is
# blocked in a number of countries and the server-fetched still is the only part
# of the stream that will reach them.
#
# Without these, a queued Kick link shows its slug and no artwork. It still plays.
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_CACHE_TTL_SECS=300
KICK_TIMEOUT_SECS=8

# --- Realtime -----------------------------------------------------------------
WS_HEARTBEAT_SECS=15
WS_CLIENT_TIMEOUT_SECS=30          # must exceed the heartbeat
WS_HANDSHAKE_TIMEOUT_SECS=5
WS_SEND_BUFFER=256                 # outbound queue before a slow client is cut

ROOM_LEASE_TTL_SECS=30             # how long a node owns a room without renewal
ROOM_LEASE_RENEW_SECS=10           # must be well below the TTL

# --- Voice --------------------------------------------------------------------
# Mesh WebRTC collapses past ~8 peers on residential upstream.
VOICE_MESH_MAX_PEERS=8

STUN_URLS=stun:stun.l.google.com:19302

# TURN is needed for symmetric NAT (a meaningful minority of mobile networks).
# Without it, some users will connect to everything except voice.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# --- Stream relay & metrics (SEKAI) ------------------------------------------
# The HLS relay re-serves third-party streams whose CORS policy refuses other
# sites. Off by default: it costs egress and can breach a stream owner's terms.
# Enable only for sources you are authorised to relay.
STREAM_RELAY_ENABLED=false

# Bearer token for scraping /metrics. Unset: open in development, 404 in
# production. Set it whenever the API is reachable without a filtering proxy.
METRICS_TOKEN=

# --- Rate limits --------------------------------------------------------------
# Sliding windows in Redis, shared across all nodes.
RL_CHAT_PER_MIN=30
RL_QUEUE_PER_MIN=20
RL_SYNC_PER_MIN=60
RL_REACTION_PER_MIN=40
RL_ROOMS_PER_HOUR=10
RL_REGISTER_PER_HOUR=10
RL_GUEST_PER_HOUR=20
RL_HTTP_PER_MIN=300

# --- Observability ------------------------------------------------------------
# Standard tracing filter. `debug` in development, `info,sqlx=warn` in prod.
# debug for local work; use info,sqlx=warn in production, where debug logs
# every query and request at volume.
RUST_LOG=debug,sqlx=info

# --- Web build ----------------------------------------------------------------
# Inlined into the client bundle at build time. Leave empty for same-origin
# deployments (the dev server proxies /api and /ws).
PUBLIC_API_URL=
PUBLIC_WS_URL=

# --- Web proxy (web runtime, not build time) -----------------------------------
# Enables the /api/** proxy in the web server (apps/web/src/server/api-proxy.ts).
# Unset in local development, where the Vite dev server proxies /api instead.
# SEKAI_API_ORIGIN=https://your-api.example        # origin only, no path
# SEKAI_PROXY_SECRET=                               # same value as the API's
# The header your web host sets to the visitor IP (Vercel: x-real-ip — verify
# after deploying; see docs/DEPLOY_RAILWAY.md). Unset: visitors share one bucket.
# SEKAI_PROXY_CLIENT_IP_HEADER=

# --- Production deployment (docker-compose.prod.yml) --------------------------
DOMAIN=playercn.mak3r.net
API_DOMAIN=api.playercn.mak3r.net
POSTGRES_USER=ytroom
POSTGRES_PASSWORD=
POSTGRES_DB=ytroom
